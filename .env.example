NODE_ENV=development
PORT=3001

# Local Postgres. On macOS+Homebrew the default is peer auth as your shell user (no password).
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/dropship

JWT_SECRET=replace-me-with-a-long-random-string-32-chars-min
DEMO_EMAIL=demo@dropship.local
DEMO_PASSWORD=demo1234

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3001
