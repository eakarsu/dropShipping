NODE_ENV=development
PORT=3001

# Local Postgres. On macOS+Homebrew the default is peer auth as your shell user (no password).
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/dropship

JWT_SECRET=replace-me-with-a-long-random-string-32-chars-min
ORDER_AUDIT_SIGNING_KEY=replace-with-a-separate-random-string-32-chars-min
ORDER_AUDIT_KEY_ID=primary

# Bootstrap accounts explicitly with `npm run account:create`; never put passwords here.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_MERCHANT_ID=
BOOTSTRAP_ROLE=merchant_admin
BOOTSTRAP_CUSTOMER_ID=

TAX_PROVIDER_URL=
TAX_PROVIDER_API_KEY=
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_API_KEY=
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_API_KEY=
INVENTORY_PROVIDER_URL=
INVENTORY_PROVIDER_API_KEY=
PARTNER_PROVIDER_URL=
PARTNER_PROVIDER_API_KEY=
WEBHOOK_PAYMENT_SECRET=
WEBHOOK_SHIPPING_SECRET=
WEBHOOK_INVENTORY_SECRET=
WEBHOOK_PARTNER_SECRET=

APP_URL=http://localhost:3001
